# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Python/runtime artifacts
__pycache__/
*.py[cod]
/models/
/.venv/

# local databases and downloaded datasets
airbnb_lite.db
*.csv.gz
listings.csv
reviews.csv
*.tar.gz
*.zip

# local Postgres backups (e.g. pg_dump output) - large, regenerable, and not
# something any deploy or script reads back in automatically
*.dump
