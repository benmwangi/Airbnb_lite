# Copy this file to .env and fill in real values:
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)
#
# .env is already covered by the repo's `.env*` .gitignore rule, so it's never committed -
# only this template (.env.example) is. db.py and external_signals.py both call
# python-dotenv's load_dotenv() before reading any of these, so once .env exists you don't
# need to `$env:...` / `export ...` them in every new shell - just start uvicorn/npm/a
# script and they're picked up automatically. An explicit env var set in your shell still
# overrides whatever is in .env.

# Required for the Postgres backend. If unset, db.py falls back to a local SQLite file
# (sqlite:///./airbnb_lite.db) - fine for a zero-setup demo, but see README.md for why
# Postgres is what this project actually runs on.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/airbnb_lite

# Optional - real event/news signals for the pricing engine (PredictHQ Events API and
# NewsAPI.org; see external_signals.py for where to get a key for each). Without these,
# the pricing engine falls back to a deterministic synthetic signal and still runs end to
# end - it's just clearly labeled "synthetic" rather than naming a real nearby event.
PREDICTHQ_API_KEY=
NEWSAPI_KEY=

# Used by the Next.js frontend. Next.js already auto-loads this from .env.local on its
# own (see airbnb-lite-web-README.md) - it's listed here too just so every variable this
# project uses lives in one reference file.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Required in a deployed environment for the scheduled maintenance job (see
# claude/deployment-scheduling-guide.md). Guards main.py's
# POST /admin/retrain-and-fix-guardrails so only the real scheduled cron call can
# trigger a retrain, not anyone who finds the URL. Leave unset locally - the endpoint
# simply refuses every request (401) rather than being silently open when unset.
# In production, set the SAME value on both the backend host (Render, reads it as a
# plain env var) and the frontend host (Vercel, which then also auto-sends it as the
# `Authorization: Bearer <value>` header on its own cron invocations - see
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs).
# Generate one with e.g. `openssl rand -hex 24`.
CRON_SECRET=
